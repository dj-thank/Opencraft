{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft.example/schemas/agent-plan.schema.json",
  "title": "OpenCraft Agent Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "worldId", "baseRevision", "title", "operations", "costUnits"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "assumptions": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 500 }
    },
    "costUnits": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "finiteScalar": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "regionId", "payload"],
      "properties": {
        "kind": {
          "enum": ["entity.create", "entity.update", "entity.delete", "terrain.patch", "semantic.link"]
        },
        "regionId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "payload": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "not": {
              "enum": ["ownerId", "worldId", "revision", "createdAt", "createdBy", "python", "script", "shell", "command"]
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["entity.update", "entity.delete"] } } },
          "then": { "required": ["entityId"] }
        }
      ]
    }
  }
}
